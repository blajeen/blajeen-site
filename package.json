{
  "name": "blajeen-labs-site",
  "version": "0.1.0",
  "private": true,
  "description": "Site institucional da Blajeen Labs e páginas públicas de Revalio e Docalio.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:content": "node tools/check-content.mjs",
    "build:assets": "node tools/build-assets.mjs",
    "qa:shots": "node tools/qa-shots.mjs",
    "qa:interacao": "node tools/check-interacao.mjs",
    "qa:contraste": "node tools/check-contraste.mjs",
    "qa": "npm run qa:shots && npm run qa:interacao && npm run qa:contraste",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run check:content && npm run build"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
