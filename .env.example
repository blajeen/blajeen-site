# URL PostgreSQL do Neon. Obrigatória em produção; no desenvolvimento sem ela os dados ficam em .data/.
DATABASE_URL=

# Gere valores longos e aleatórios. Nunca publique os valores reais no repositório.
ONBOARDING_SESSION_SECRET=
ONBOARDING_ADMIN_PASSWORD=

# Opcional. Quando ausente, os arquivos ficam no próprio Neon em produção e localmente no desenvolvimento sem banco.
BLOB_READ_WRITE_TOKEN=

# Prazo padrão dos links do cliente, em dias.
ONBOARDING_TOKEN_TTL_DAYS=30

# Destino e provedor do aviso automático quando um cliente conclui o formulário.
ONBOARDING_NOTIFICATION_EMAIL=brg.ftw@gmail.com
RESEND_API_KEY=
ONBOARDING_EMAIL_FROM=

# Configuração já existente do site.
NEXT_PUBLIC_SITE_URL=https://blajeen.com.br
SITE_PUBLICACAO=

# Loja de exclusivos. Sem estas chaves, a loja recebe pedidos sem pagamento online e o frete fica a combinar.
# Pagamento pelo Asaas: chave da API, ambiente (sandbox para testar) e o token cadastrado no webhook.
# Num arquivo .env a chave vai com uma barra antes do $ (ASAAS_API_KEY=\$aact_...); na Vercel, sem a barra.
ASAAS_API_KEY=
ASAAS_AMBIENTE=
ASAAS_WEBHOOK_TOKEN=
# Frete pelo Melhor Envio: token da API e ambiente (sandbox para testar).
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_AMBIENTE=

# Redes sociais do titular — conexão direta às APIs oficiais, sem serviço de publicação intermediário.
# Chave exclusiva e aleatória, com pelo menos 32 caracteres. Nunca use NEXT_PUBLIC_ para segredos.
SOCIAL_TOKEN_SECRET=
# Meta: Página do Facebook e Instagram profissional vinculado. Informe a versão do app no console.
SOCIAL_META_APP_ID=
SOCIAL_META_APP_SECRET=
SOCIAL_META_API_VERSION=
# Google Cloud: OAuth para aplicativo Web, YouTube Data API habilitada.
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=
# X: OAuth 2.0 com PKCE, aplicativo confidencial Web e acesso de escrita/mídia.
SOCIAL_X_CLIENT_ID=
SOCIAL_X_CLIENT_SECRET=
# TikTok: Login Kit e Content Posting API (video.upload). Publicação é finalizada no app TikTok.
SOCIAL_TIKTOK_CLIENT_KEY=
SOCIAL_TIKTOK_CLIENT_SECRET=
